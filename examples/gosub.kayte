' GOSUB ... RETURN in BASIC-style Kayte: at the top level (with END to stop
' before the routines), nested, and inside SUBs and FUNCTIONs.
'   kayte --compile examples/gosub.kayte -o gosub.bytecode
'   kayte --run gosub.bytecode

total = 0
FOR i = 1 TO 3
  GOSUB AddSquare
NEXT
PRINT "sum of squares 1..3:", total

level = 0
GOSUB Outer
PRINT "nested GOSUBs reached level", level

CALL Report(5)
CALL Bail(1)
PRINT "Bail: EXIT SUB from inside a GOSUB unwound correctly"
PRINT "Twice(21) from a GOSUB routine:", Twice(21)
PRINT "Fact(6) with a GOSUB in a recursive FUNCTION:", Fact(6)

IF total > 0 THEN
  PRINT "END inside an IF stops the program here"
  END
END IF
PRINT "never printed"

AddSquare:
  total = total + i * i
  RETURN

Outer:
  level = level + 1
  GOSUB Inner
  RETURN
Inner:
  level = level + 10
  RETURN

SUB Report(n)
  GOSUB Display
  PRINT "Report: back from GOSUB, now RETURN leaves the SUB"
  RETURN
  PRINT "never printed"
Display:
  PRINT "Report: showing", n
  RETURN
END SUB

SUB Bail(v)
  GOSUB Deep
  PRINT "never printed (Bail exited from inside Deep)"
Deep:
  GOSUB Deeper
  PRINT "never printed either"
  RETURN
Deeper:
  EXIT SUB
END SUB

FUNCTION Twice(x)
  GOSUB Compute
  PRINT "never printed (RETURN value leaves the FUNCTION)"
Compute:
  RETURN x * 2
END FUNCTION

FUNCTION Fact(n)
  DIM r
  IF n <= 1 THEN RETURN 1
  GOSUB Recurse
  RETURN r
Recurse:
  r = n * Fact(n - 1)
  RETURN
END FUNCTION
