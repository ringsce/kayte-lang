' A Kayte GUI: the window is declared in examples/ui.kfm and built as a
' native Qt6 window by QT "loadform"; the click handler is the SUB below.
' Build libkayte_qt6 first (scripts/build-kayte-qt6.sh), then, from the
' repository root:
'   kayte --compile examples/ui.kayte -o ui.bytecode
'   kayte --run ui.bytecode

QT "init"
QT "loadform", "examples/ui.kfm" TO win
QT "show", win
QT "run"

' Called when the button is clicked (onclick: showMessage() in ui.kfm)
SUB showMessage()
  PRINT "Button clicked!"
  QT "message", "Kayte GUI Demo", "Button clicked!"
END SUB
