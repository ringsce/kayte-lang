' Control flow in BASIC-style Kayte: block IF / ELSEIF / ELSE / END IF,
' single-line IF ... THEN ... ELSE, and FOR ... TO ... STEP ... NEXT.
'   kayte --compile examples/control_flow.kayte -o control_flow.bytecode
'   kayte --run control_flow.bytecode

FOR i = 1 TO 5
  IF i = 1 THEN
    PRINT i, "one"
  ELSEIF i = 2 THEN
    PRINT i, "two"
  ELSEIF i < 5 THEN   ' a comment after THEN
    PRINT i, "three or four"
  ELSE
    PRINT i, "five"
  END IF
NEXT i

' counting down, and STEP from a (negative) variable
s = -3
out = ""
FOR k = 10 TO 1 STEP s
  out = out & k & " "
NEXT
PRINT "down:", out

' nested loops, ENDIF spelling, IF without ELSE
total = 0
FOR a = 1 TO 3
  FOR b = 1 TO 3
    IF a = b THEN
      total = total + 10
    ENDIF
    total = total + 1
  NEXT b
NEXT a
PRINT "nested total:", total

' zero iterations
FOR z = 5 TO 1
  PRINT "never"
NEXT z
PRINT "after empty loop z =", z

' single-line IF with ELSE
x = 7
IF x > 5 THEN PRINT "big" ELSE PRINT "small"
IF x > 50 THEN PRINT "huge" ELSE PRINT "not huge"
IF x = 7 THEN PRINT "seven"

' blocks inside a SUB and a WHILE
CALL Classify(0)
CALL Classify(15)
CALL Classify(-4)
n = 0
WHILE n < 3
  IF n = 1 THEN
    PRINT "while n=1"
  ELSE
    PRINT "while n<>1"
  END IF
  n = n + 1
END WHILE

SUB Classify(v)
  IF v = 0 THEN
    PRINT v, "is zero"
  ELSE
    IF v > 0 THEN
      PRINT v, "is positive"
    ELSE
      PRINT v, "is negative"
    END IF
  END IF
END SUB
