# Build output (scripts write here; regenerable)
build/
bin/
lib/
*.o
*.or
*.a
*.so
*.dylib
*.dll
*.exe
*.ppu
*.compiled
*.bytecode

# The programs build into bin/ and build/units/ (ignored above); lazbuild
# and the linker also leave these next to the .lpi files in source/
/source/*.res
/source/link*.res
/source/symbol_order*.fpc

# Lazarus / Free Pascal user state
*.lps
backup/

# Package installs
node_modules/

# Editors / OS
.DS_Store
.vscode/*
!.vscode/settings.json
*.identcache
*.local
*.~*
