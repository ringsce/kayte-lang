<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="vb6interpreter"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="vb6interpreter.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="interpreterutils.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="InterpreterUtils"/>
      </Unit>
      <Unit>
        <Filename Value="interpretercore.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="InterpreterCore"/>
      </Unit>
      <Unit>
        <Filename Value="dhtml.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="vbcompiler.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="VBCompiler"/>
      </Unit>
      <Unit>
        <Filename Value="synvbhighlighter.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="SynVBHighlighter"/>
      </Unit>
      <Unit>
        <Filename Value="jsbindings.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="JSBindings"/>
      </Unit>
      <Unit>
        <Filename Value="wincominterop.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="WinComInterop"/>
      </Unit>
      <Unit>
        <Filename Value="frm.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="Form1"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="bytecodetypes.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="BytecodeTypes"/>
      </Unit>
      <Unit>
        <Filename Value="bytecodevm.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="BytecodeVM"/>
      </Unit>
      <Unit>
        <Filename Value="lexer.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Lexer"/>
      </Unit>
      <Unit>
        <Filename Value="parser.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Parser"/>
      </Unit>
      <Unit>
        <Filename Value="vmui.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="VMUI"/>
      </Unit>
      <Unit>
        <Filename Value="formgenerator.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="FormGenerator"/>
      </Unit>
      <Unit>
        <Filename Value="tokendefs.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TokenDefs"/>
      </Unit>
      <Unit>
        <Filename Value="umaininterpreterform.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UMainInterpreterForm"/>
      </Unit>
      <Unit>
        <Filename Value="uvm.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UVM"/>
      </Unit>
      <Unit>
        <Filename Value="uparsertypes.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UParserTypes"/>
      </Unit>
      <Unit>
        <Filename Value="ukfrmtypes.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UKfrmTypes"/>
      </Unit>
      <Unit>
        <Filename Value="fkfrmruntime.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="FKfrmRuntime"/>
      </Unit>
      <Unit>
        <Filename Value="../kfrm/router/ueventrouter.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UEventRouter"/>
      </Unit>
      <Unit>
        <Filename Value="ukfrmparser.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UKfrmParser"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../bin/vb6interpreter"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value=".;../kfrm/router"/>
      <UnitOutputDirectory Value="../build/units/vb6interpreter/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
    </Linking>
    <Other>
      <Conditionals Value="if TargetOS='darwin' then
begin
  CustomOptions := CustomOptions+' -WM10.15';
end;"/>
    </Other>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
